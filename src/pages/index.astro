---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import painting from '../assets/painting.jpg';
import { site } from '../data/site';
import { getProjects, url } from '../lib/content';

const projects = await getProjects();
---

<Base overlayHeader>
  <section class="hero" id="top">
    <Image
      class="hero-img"
      src={painting}
      alt={site.hero.imageAlt}
      widths={[800, 1400, 2000, 2800]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-light"></div>
    <div class="hero-shade"></div>

    <div class="hero-copy">
      <div class="hero-text">
        <h1>{site.hero.headline} {site.hero.headlineItalic && <em>{site.hero.headlineItalic}</em>}</h1>
        {site.hero.intro && <p>{site.hero.intro}</p>}
        <div class="actions">
          <a class="btn btn-reveal" href="#work">{site.hero.primaryButton}</a>
          <a class="btn btn-reveal" href={site.links.graveResearch}>{site.hero.secondaryButton}</a>
          <a class="btn btn-reveal" href={site.links.github}>GitHub</a>
          <a class="btn btn-reveal" href={site.links.linkedin}>LinkedIn</a>
        </div>
      </div>
      <a class="cue-wrap" href="#about">SCROLL <span class="cue"></span></a>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap section-inner about">
      <h2 class="page-title">{site.about.heading}</h2>
      <div class="prose">
        {site.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <a class="btn btn-line" href={url(site.about.resumeFile)}>{site.about.resumeButton}</a>
    </div>
  </section>

  <section class="section" id="work">
    <div class="wrap section-inner">
      <h2 class="page-title">{site.sections.projects}</h2>
      <div class="cards">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
      <a class="ul more" href={url('projects/')}>{site.sections.allProjects} →</a>
    </div>
  </section>
</Base>

<script>
  // Moonlight follows the pointer across the hero.
  const hero = document.querySelector<HTMLElement>('.hero');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && !reduceMotion) {
    let frame = 0;
    hero.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = hero.getBoundingClientRect();
        hero.style.setProperty('--x', String(((e.clientX - r.left) / r.width) * 100));
        hero.style.setProperty('--y', String(((e.clientY - r.top) / r.height) * 100));
      });
    });
  }

</script>
