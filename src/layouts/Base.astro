---
import '../styles/global.css';
import { site } from '../data/site';
import { url } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  overlayHeader?: boolean;
  current?: 'blog' | 'projects';
}

const { title, description = site.description, overlayHeader = false, current } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0907" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Instrument+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <svg class="grain" aria-hidden="true">
      <filter id="grain">
        <feTurbulence type="fractalNoise" baseFrequency=".85" numOctaves="3" stitchTiles="stitch"></feTurbulence>
        <feColorMatrix type="saturate" values="0"></feColorMatrix>
      </filter>
      <rect width="100%" height="100%" filter="url(#grain)"></rect>
    </svg>

    <header class:list={['site-header', { overlay: overlayHeader }]}>
      <a class="brand" href={url()}>{site.name}</a>
      <nav class="site-nav" aria-label="Main">
        <a class="ul" href={url('blog/')} aria-current={current === 'blog' ? 'page' : undefined}>Blog</a>
        <a class="ul" href={url('projects/')} aria-current={current === 'projects' ? 'page' : undefined}>Projects</a>
        <a class="ul" href="#contact">Contact</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer" id="contact">
      <div class="wrap">
        <div>
          <h2>{site.contact.heading}</h2>
          <p>{site.contact.email}</p>
        </div>
        <nav class="site-nav" aria-label="Elsewhere">
          <a class="ul" href={site.links.github}>GitHub</a>
          <a class="ul" href={site.links.linkedin}>LinkedIn</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
